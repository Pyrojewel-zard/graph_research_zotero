ZOTERO_MCP_URL=http://127.0.0.1:23120/mcp
ZOTERO_LIBRARY_ID=
MKG_DB_PATH=./data/mkg.db

# Used only when the MKG database itself has no active LLM provider configured.
MKG_LLM_PROVIDER=openai
MKG_LLM_API_KEY=
MKG_LLM_MODEL=gpt-5-mini
MKG_LLM_BASE_URL=https://api.openai.com/v1

# Optional MKG enrichment
MKG_ENABLE_S2_ENRICHMENT=false

# Level-2 deep reading. Only selected papers should use this path.
DEEP_READ_AGENT=codex
DEEP_READ_AGENT_TIMEOUT_SECONDS=900
DEEP_READ_DIR=./data/deep_reads

# Codex CLI (uses existing local CLI authentication)
CODEX_BINARY=codex
CODEX_MODEL=

# Claude Code CLI (uses existing local CLI authentication)
CLAUDE_BINARY=claude
CLAUDE_MODEL=

# Second-order embedding of PaperSignature only.
# Leave unset to disable research-signature embedding while still using deep-read notes/signatures.
# Any OpenAI-compatible /embeddings endpoint may be used, including a local server.
RESEARCH_EMBEDDING_BASE_URL=
RESEARCH_EMBEDDING_API_KEY=
RESEARCH_EMBEDDING_MODEL=
RESEARCH_EMBEDDING_TIMEOUT_SECONDS=120
